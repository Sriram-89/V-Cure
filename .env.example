# ============================================================
# V-CURE PLATFORM — ROOT ENVIRONMENT VARIABLE CHEATSHEET
# ============================================================

# Frontend (vcure-frontend)
NEXT_PUBLIC_API_BASE_URL=https://vcure-backend.onrender.com/api/v1
NEXT_PUBLIC_APP_URL=https://v-cure-health.vercel.app

# Frontend Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Frontend Supabase Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=medical-reports

# Backend API (vcure-backend-complete/acc2/apps/api)
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://v-cure-health.vercel.app

# PostgreSQL Database (Supabase / Managed PostgreSQL)
DATABASE_URL=postgresql://postgres:your-db-password@your-db-host:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:your-db-password@your-db-host:5432/postgres?schema=public

# JWT Security Secrets
JWT_ACCESS_SECRET=your-secure-access-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your-secure-refresh-secret
JWT_REFRESH_EXPIRY=30d

# Backend Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-admin-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----"
