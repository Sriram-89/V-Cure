# ============================================================
# V-CURE — DATABASE & AI LAYER — ENVIRONMENT VARIABLES
# Per 03_DATABASE_ARCHITECTURE.md / 07_BACKEND_ARCHITECTURE.md
# ============================================================

# PostgreSQL (primary datastore — DATABASE.md Section 3)
DATABASE_URL="postgresql://vcure_user:CHANGE_ME@localhost:5432/vcure?schema=public"
# Direct (non-pooled) connection — required by Prisma Migrate when using PgBouncer/connection pooling
DIRECT_URL="postgresql://vcure_user:CHANGE_ME@localhost:5432/vcure?schema=public"

# Redis (cache — DATABASE.md Section 58; queues — BACKEND.md)
REDIS_URL="redis://localhost:6379"

# AI Providers (AI___DESIGN master prompt — AI TECH STACK)
OPENAI_API_KEY="sk-CHANGE_ME"
GEMINI_API_KEY="CHANGE_ME"

# Vector Database (RAG / Embeddings)
VECTOR_DB_URL="CHANGE_ME"

# Field-level encryption key for sensitive medical columns (DATABASE.md Section 61)
MEDICAL_DATA_ENCRYPTION_KEY="CHANGE_ME_32_BYTE_KEY"

NODE_ENV="development"
